{
	"name": "studio",
	"version": "0.0.1",
	"private": true,
	"description": "Chromatics studio: the scriptable color language and interactive studio, deployed to GitHub Pages.",
	"author": "Andraž Mesarič-Sirec",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "bun test",
		"baseline": "bun scripts/baseline.ts",
		"package-docs": "bun scripts/package-docs.ts"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.3",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.0",
		"@lezer/highlight": "^1.2.3",
		"@lilbunnyrabbit/chromatics": "workspace:*",
		"acorn": "^8.16.0",
		"codemirror": "^6.0.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.14",
		"@types/estree": "^1.0.8",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	}
}
