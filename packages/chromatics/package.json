{
  "name": "@lilbunnyrabbit/chromatics",
  "version": "0.0.0",
  "description": "Every color model and color system, typed, with cited math and exhaustive tests.",
  "author": "Andraž Mesarič-Sirec <amesaricsirec@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilBunnyRabbit/chromatics.git",
    "directory": "packages/chromatics"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.domain.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all": {
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    },
    "./a98-rgb": {
      "types": "./dist/models/a98-rgb/a98-rgb.d.ts",
      "default": "./dist/models/a98-rgb/a98-rgb.js"
    },
    "./display-p3": {
      "types": "./dist/models/display-p3/display-p3.d.ts",
      "default": "./dist/models/display-p3/display-p3.js"
    },
    "./hsl": {
      "types": "./dist/models/hsl/hsl.d.ts",
      "default": "./dist/models/hsl/hsl.js"
    },
    "./hsv": {
      "types": "./dist/models/hsv/hsv.d.ts",
      "default": "./dist/models/hsv/hsv.js"
    },
    "./hwb": {
      "types": "./dist/models/hwb/hwb.d.ts",
      "default": "./dist/models/hwb/hwb.js"
    },
    "./lab": {
      "types": "./dist/models/lab/lab.d.ts",
      "default": "./dist/models/lab/lab.js"
    },
    "./lch": {
      "types": "./dist/models/lch/lch.d.ts",
      "default": "./dist/models/lch/lch.js"
    },
    "./linear-display-p3": {
      "types": "./dist/models/linear-display-p3/linear-display-p3.d.ts",
      "default": "./dist/models/linear-display-p3/linear-display-p3.js"
    },
    "./linear-srgb": {
      "types": "./dist/models/linear-srgb/linear-srgb.d.ts",
      "default": "./dist/models/linear-srgb/linear-srgb.js"
    },
    "./oklab": {
      "types": "./dist/models/oklab/oklab.d.ts",
      "default": "./dist/models/oklab/oklab.js"
    },
    "./oklch": {
      "types": "./dist/models/oklch/oklch.d.ts",
      "default": "./dist/models/oklch/oklch.js"
    },
    "./prophoto-rgb": {
      "types": "./dist/models/prophoto-rgb/prophoto-rgb.d.ts",
      "default": "./dist/models/prophoto-rgb/prophoto-rgb.js"
    },
    "./rec2020": {
      "types": "./dist/models/rec2020/rec2020.d.ts",
      "default": "./dist/models/rec2020/rec2020.js"
    },
    "./srgb": {
      "types": "./dist/models/srgb/srgb.d.ts",
      "default": "./dist/models/srgb/srgb.js"
    },
    "./srgb8": {
      "types": "./dist/models/srgb8/srgb8.d.ts",
      "default": "./dist/models/srgb8/srgb8.js"
    },
    "./xyz50": {
      "types": "./dist/models/xyz50/xyz50.d.ts",
      "default": "./dist/models/xyz50/xyz50.js"
    },
    "./xyz65": {
      "types": "./dist/models/xyz65/xyz65.d.ts",
      "default": "./dist/models/xyz65/xyz65.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:bun": "bunx --bun vitest run",
    "test:all": "vitest run && bunx --bun vitest run",
    "matrices": "bun scripts/matrices/derive.ts",
    "fixtures:culori": "bun scripts/fixtures/culori.ts",
    "exports": "bun scripts/exports.ts"
  },
  "dependencies": {
    "@lilbunnyrabbit/optional": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/culori": "4.0.1",
    "culori": "4.0.2",
    "fast-check": "4.10.2",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
