{
  "name": "chromatics-monorepo",
  "private": true,
  "description": "Chromatics: the @lilbunnyrabbit/chromatics color package and the studio that uses it.",
  "author": "Andraž Mesarič-Sirec",
  "license": "MIT",
  "homepage": "https://lilbunnyrabbit.github.io/chromatics/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilBunnyRabbit/chromatics.git"
  },
  "bugs": {
    "url": "https://github.com/lilBunnyRabbit/chromatics/issues"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=studio",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "prettier --check . && bun --filter studio lint",
    "format": "prettier --write . && bun --filter studio format",
    "changeset": "bun --bun x changeset",
    "release": "turbo run check test build --filter=@lilbunnyrabbit/chromatics && bun --bun x changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "prettier": "^3.8.1",
    "turbo": "2.11.7"
  }
}
