{
	"name": "chromatics",
	"version": "0.0.1",
	"description": "A scriptable color language and interactive studio — derive palettes from one brand color, inspect ~100 color models, check accessibility, and preview on real UI. OKLCH-native, culori-backed.",
	"author": "Andraž Mesarič-Sirec",
	"license": "MIT",
	"homepage": "https://lilbunnyrabbit.github.io/chromatics/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilBunnyRabbit/chromatics.git"
	},
	"bugs": {
		"url": "https://github.com/lilBunnyRabbit/chromatics/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:package": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "bun test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css",
		"**/models/**"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.3.14",
		"@types/culori": "^4.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"keywords": [
		"svelte",
		"color",
		"colour",
		"oklch",
		"culori",
		"palette",
		"color-models",
		"color-science",
		"dsl",
		"accessibility",
		"wcag",
		"apca",
		"design-tokens",
		"design-system"
	],
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.3",
		"@codemirror/search": "^6.7.1",
		"@lezer/highlight": "^1.2.3",
		"acorn": "^8.16.0",
		"codemirror": "^6.0.2",
		"culori": "^4.0.2"
	}
}
